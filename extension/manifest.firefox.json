{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "Webmister Download Manager",
    "homepage_url": "https://github.com/mohamedyassine-benmiled/misterdownloadmanager-web",
    "version": "0.1.0",
    "description": "Independent Mister Download Manager fork: capture downloads locally or send them to your self-hosted Webmister server.",
    "browser_specific_settings": {
        "gecko": {
            "id": "integration@misterdownloadmanager.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "downloads",
        "contextMenus",
        "nativeMessaging",
        "cookies",
        "storage",
        "webRequest",
        "webRequestBlocking",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "optional_permissions": [
        "proxy"
    ],
    "background": {
        "scripts": [
            "remote.js",
            "background.js"
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Webmister Download Manager",
        "default_icon": {
            "16": "icons/webmister-16.png",
            "32": "icons/webmister-32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "video.js"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "page.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/webmister-16.png",
        "32": "icons/webmister-32.png",
        "48": "icons/webmister-48.png",
        "128": "icons/webmister-128.png"
    }
}
