[Unit]
Description=Mister Download Manager headless server
Documentation=https://github.com/mohamedyassine-benmiled/misterdownloadmanager-web
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/downloads

[Service]
Type=simple
User=mdm
Group=mdm
StateDirectory=mdm
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mdm
Environment=MDM_DATA_DIR=/var/lib/mdm
Environment=MDM_DOWNLOADS=/srv/downloads
Environment=MDM_REMOTE_LISTEN=127.0.0.1
Environment=MDM_REMOTE_PORT=8463
Environment=MDM_REMOTE_HOSTS=localhost
EnvironmentFile=-/etc/mdm/mdm.env
ExecStart=/usr/local/bin/misterdownloadmanager --headless
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
