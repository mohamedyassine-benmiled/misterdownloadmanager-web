# Install as /etc/mdm/mdm.env (root-owned, mode 0600).
# No shell expansion here: use absolute paths, not ~ or $HOME.
MDM_DATA_DIR=/var/lib/mdm
MDM_DOWNLOADS=/srv/downloads
MDM_REMOTE_LISTEN=127.0.0.1
MDM_REMOTE_PORT=8463
MDM_REMOTE_HOSTS=localhost
MDM_REMOTE_URL=https://localhost:8463/
TZ=Etc/UTC

# For LAN/VPN access, replace the listener with an address assigned to this machine,
# update MDM_REMOTE_URL, add your chosen hostname to MDM_REMOTE_HOSTS, and configure
# the firewall. The current runtime refuses wildcard and public listener addresses.
# If you change MDM_DOWNLOADS, also change RequiresMountsFor in the service drop-in.
