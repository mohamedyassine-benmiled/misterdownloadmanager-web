# Used with: docker compose --env-file docker/.env -f docker/compose.yml up -d --build
# Published by the fork's Web image workflow. A versioned web-vX.Y.Z tag also publishes :X.Y.Z.
# Use up --no-build to run a pulled image; up --build still builds this checkout.
MDM_IMAGE=ghcr.io/mohamedyassine-benmiled/misterdownloadmanager-web:edge
MDM_BUILD_PROFILE=release

# Set to the owner of the bind-mounted directories (on Linux: id -u and id -g).
MDM_UID=1000
MDM_GID=1000

# Relative mount paths resolve from docker/compose.yml's directory, not the shell's cwd.
# Create these folders before starting Docker; don't let Docker create root-owned folders.
MDM_CONFIG_DIR=./config
MDM_DOWNLOADS_DIR=./downloads

# Safe default: access from this host only. For another device, set the server's LAN/VPN IP.
# Do not expose the legacy remote API directly to the public internet.
MDM_BIND_ADDRESS=127.0.0.1
MDM_WEB_PORT=8463
MDM_REMOTE_URL=http://localhost:8463/
# Set to 1 for built-in HTTPS; also change MDM_REMOTE_URL to https://.
MDM_REMOTE_TLS=0
# Comma-separated hostnames allowed in addition to the server's own addresses.
MDM_REMOTE_HOSTS=localhost
# Experimental qBittorrent API; keep disabled until doing a side-by-side test.
# Container peers are not loopback: explicitly allow only the verified client subnet.
MDM_QBIT_API=0
MDM_QBIT_ALLOWED_SUBNETS=127.0.0.1/32,::1/128
# Passwordless control for allowed peers; leave disabled unless explicitly required.
MDM_QBIT_AUTH_BYPASS=0
TZ=Etc/UTC
